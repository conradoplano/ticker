# Copy to .env and adjust.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=false

# Hostnames/IPs the app is reached by (comma separated)
ALLOWED_HOSTS=localhost,127.0.0.1,nas.local
# Full origins, needed for form posts when served over https or a non-default port
CSRF_TRUSTED_ORIGINS=http://nas.local:5001

# Set to true when behind a reverse proxy that terminates HTTPS
BEHIND_PROXY=false
SECURE_COOKIES=false

TIME_ZONE=Europe/Berlin
SITE_NAME=Ticker

# Created/updated as admin on every container start (optional)
INITIAL_ADMIN_EMAIL=

# SMTP for login codes. Leave EMAIL_HOST empty to print emails to the container logs instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Ticker <ticker@example.com>

# Login code lifetime in seconds
LOGIN_CODE_MAX_AGE=600

# Anyone can create an account. false: only with adduser.
REGISTRATION_OPEN=true
# Address of the app for links in emails (default: the first CSRF_TRUSTED_ORIGINS entry)
SITE_URL=

# AI for ranking, the setup wizard, the briefing and the learned profile (https://platform.openai.com/api-keys).
# Empty: no AI; the feed is ranked by topic keywords.
OPENAI_API_KEY=
AI_MODEL=gpt-5.4-mini
AI_EFFORT=low
# What AI may cost per day in USD: per person (admins can change it per person) and for all together
AI_DAILY_LIMIT_USD=0.10
AI_GLOBAL_DAILY_LIMIT_USD=1.00
# Free AI for new people before an admin approves them: hours from sign-up, USD per person for the whole trial,
# and USD per day for all trial users together (so mass sign-ups can't run up costs). AI_TRIAL_HOURS=0: no trial.
AI_TRIAL_HOURS=24
AI_TRIAL_LIMIT_USD=0.10
AI_TRIAL_GLOBAL_DAILY_LIMIT_USD=0.50

# Background fetching and refreshing inside the web container
RUN_SCHEDULER=true
# Articles older than this many days are deleted unless someone saved them
ARTICLE_MAX_AGE_DAYS=30
# Seconds one feed request may take
FETCH_TIMEOUT=15
